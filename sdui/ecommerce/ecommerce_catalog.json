{
  "${'$'}schema": "https://heimui.io/schema/v1/screen.json",
  "id": "ecommerce_catalog",
  "version": "1.0.0",
  "title": "Product Catalog",
  "apply_safe_insets": true,
  "root": {
    "type": "lazy_column",
    "id": "catalog_col",
    "spacing": 14,
    "padding": 16,
    "items": [
      { "type": "text", "id": "cat_title", "text": "Top Trending Hardware", "style": "TITLE_MEDIUM", "color": "#FFFFFF" },
      {
        "type": "card",
        "id": "item_1",
        "background_color": "#1E293B",
        "corner_radius": 12,
        "padding": 16,
        "actions": [
          {
            "type": "show_bottom_sheet",
            "title": "Checkout Confirmation",
            "content": {
              "type": "container",
              "id": "sheet_c",
              "direction": "VERTICAL",
              "spacing": 12,
              "padding": 20,
              "children": [
                { "type": "text", "id": "sh_name", "text": "Heimdall ANC Cyber Headphones", "style": "TITLE_LARGE", "color": "#FFFFFF" },
                { "type": "text", "id": "sh_price", "text": "$299.00 USD", "style": "TITLE_MEDIUM", "color": "#00E5FF" },
                {
                  "type": "button",
                  "id": "buy_btn",
                  "title": "Place Order Now",
                  "variant": "FILLED",
                  "is_full_width": true,
                  "actions": [
                    { "type": "dismiss_modal" },
                    { "type": "show_snackbar", "message": "✅ Order Placed Successfully!" }
                  ]
                }
              ]
            }
          }
        ],
        "child": {
          "type": "container",
          "id": "item_row_1",
          "direction": "HORIZONTAL",
          "spacing": 12,
          "alignment": "CENTER",
          "children": [
            { "type": "icon", "id": "ic_h", "name": "headphones", "tint": "#00E5FF", "size": 36 },
            {
              "type": "container",
              "id": "info_h",
              "direction": "VERTICAL",
              "spacing": 2,
              "children": [
                { "type": "text", "id": "n_h", "text": "Heimdall ANC Cyber Headphones", "style": "BODY_LARGE", "color": "#FFFFFF" },
                { "type": "text", "id": "p_h", "text": "$299.00 USD · Tap for details", "style": "BODY_SMALL", "color": "#00E5FF" }
              ]
            }
          ]
        }
      }
    ]
  }
}
