{
  "$schema": "https://heimui.io/schema/v1/screen.json",
  "id": "paywall_usage",
  "version": "1.0.0",
  "title": "Usage & SLA",
  "apply_safe_insets": true,
  "root": {
    "type": "lazy_column",
    "id": "pw_use_col",
    "spacing": 14,
    "padding": 16,
    "items": [
      {
        "type": "text",
        "id": "t_usg_hdr",
        "text": "API & SDUI Bandwidth Quotas",
        "style": "titleMedium",
        "color": "#FFFFFF"
      },
      {
        "type": "card",
        "id": "c_quota",
        "background_color": "#161D2F",
        "corner_radius": 12,
        "padding": 16,
        "child": {
          "type": "container",
          "id": "q_box",
          "direction": "VERTICAL",
          "spacing": 6,
          "children": [
            {
              "type": "text",
              "id": "t_reqs",
              "text": "Requests this month: 2.4M / 10M",
              "style": "bodyMedium",
              "color": "#00E5FF"
            },
            {
              "type": "text",
              "id": "t_sla",
              "text": "Uptime SLA: 99.99% Guaranteed",
              "style": "bodySmall",
              "color": "#94A3B8"
            }
          ]
        }
      }
    ]
  }
}
