{
  "id": "storybook_primitives",
  "version": "1.0.0",
  "title": "UI Primitives",
  "apply_safe_insets": true,
  "root": {
    "type": "lazy_column",
    "id": "sb_prim_col",
    "spacing": 16,
    "padding": {
      "horizontal": 16,
      "top": 8,
      "bottom": 96
    },
    "items": [
      {
        "type": "card",
        "id": "c_sb_head",
        "background_color": "#161D2F",
        "corner_radius": 12,
        "padding": 16,
        "child": {
          "type": "container",
          "id": "sb_in",
          "direction": "VERTICAL",
          "spacing": 6,
          "children": [
            {
              "type": "badge",
              "id": "b_sb_tag",
              "text": "STORYBOOK COMPONENT CATALOG",
              "background_color": "#EC4899",
              "text_color": "#FFFFFF"
            },
            {
              "type": "text",
              "id": "t_sb_1",
              "text": "HeimUI Native Primitives",
              "style": "titleMedium",
              "color": "#FFFFFF"
            },
            {
              "type": "text",
              "id": "t_sb_2",
              "text": "All rendered natively in Compose Multiplatform from JSON.",
              "style": "bodySmall",
              "color": "#94A3B8"
            }
          ]
        }
      },
      {
        "type": "text",
        "id": "t_btn_hdr",
        "text": "Button Variants",
        "style": "titleSmall",
        "color": "#EC4899"
      },
      {
        "type": "container",
        "id": "btn_c",
        "direction": "VERTICAL",
        "spacing": 8,
        "children": [
          {
            "type": "button",
            "id": "b_fil",
            "title": "Filled Variant Button",
            "variant": "FILLED",
            "is_full_width": true
          },
          {
            "type": "button",
            "id": "b_out",
            "title": "Outlined Variant Button",
            "variant": "OUTLINED",
            "is_full_width": true
          },
          {
            "type": "button",
            "id": "b_ton",
            "title": "Tonal Variant Button",
            "variant": "TONAL",
            "is_full_width": true
          }
        ]
      },
      {
        "type": "text",
        "id": "t_in_hdr",
        "text": "Text Input & State",
        "style": "titleSmall",
        "color": "#EC4899"
      },
      {
        "type": "text_field",
        "id": "tf_sb_sample",
        "state_key": "sb_sample_input",
        "label": "Dynamic Form Field",
        "placeholder": "Type here to see state react..."
      },
      {
        "type": "text",
        "id": "t_rich_hdr",
        "text": "Rich text",
        "style": "titleMedium",
        "color": "primary"
      },
      {
        "type": "card",
        "id": "c_rich",
        "background_color": "surface",
        "corner_radius": 12,
        "padding": 16,
        "child": {
          "type": "rich_text",
          "id": "rt_legal",
          "style": "bodyMedium",
          "align": "START",
          "spans": [
            {
              "text": "One paragraph, many runs. "
            },
            {
              "text": "Bold",
              "weight": "bold"
            },
            {
              "text": ", "
            },
            {
              "text": "tinted",
              "color": "primary"
            },
            {
              "text": ", and a "
            },
            {
              "text": "link",
              "weight": "semibold",
              "url": "https://heimui.io/sdk/#richtext"
            },
            {
              "text": " that opens through the same scheme policy as any action — so "
            },
            {
              "text": "javascript:",
              "weight": "medium"
            },
            {
              "text": " is refused in prose exactly as it is in a button."
            }
          ]
        }
      },
      {
        "type": "text",
        "id": "t_style_hdr",
        "text": "Container styling",
        "style": "titleMedium",
        "color": "primary"
      },
      {
        "type": "container",
        "id": "style_demo",
        "direction": "HORIZONTAL",
        "spacing": 10,
        "scrollable": false,
        "children": [
          {
            "type": "box",
            "id": "sw_radius",
            "weight": 1,
            "frame": {
              "min_height": 64
            },
            "corner_radius": 16,
            "background_color": "primaryContainer",
            "padding": 12,
            "content_alignment": "CENTER",
            "children": [
              {
                "type": "text",
                "id": "sw_r_t",
                "text": "radius 16",
                "style": "labelMedium",
                "color": "onPrimaryContainer"
              }
            ]
          },
          {
            "type": "box",
            "id": "sw_border",
            "weight": 1,
            "frame": {
              "min_height": 64
            },
            "corner_radius": 16,
            "border_color": "primary",
            "border_width": 2,
            "padding": 12,
            "content_alignment": "CENTER",
            "children": [
              {
                "type": "text",
                "id": "sw_b_t",
                "text": "border 2dp",
                "style": "labelMedium",
                "color": "primary"
              }
            ]
          }
        ]
      }
    ]
  }
}
