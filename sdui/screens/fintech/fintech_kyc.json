{
  "id": "fintech_kyc",
  "version": "1.0.0",
  "title": "KYC Verification",
  "apply_safe_insets": true,
  "root": {
    "type": "lazy_column",
    "id": "kyc_col",
    "spacing": 16,
    "padding": {
      "horizontal": 16,
      "top": 8,
      "bottom": 96
    },
    "items": [
      {
        "type": "card",
        "id": "kyc_banner",
        "background_color": "#161D2F",
        "corner_radius": 12,
        "padding": 16,
        "child": {
          "type": "container",
          "id": "kyc_t_box",
          "direction": "VERTICAL",
          "spacing": 4,
          "children": [
            {
              "type": "badge",
              "id": "b_reg",
              "text": "REGULATORY ONBOARDING",
              "background_color": "#4F46E5",
              "text_color": "#FFFFFF"
            },
            {
              "type": "text",
              "id": "t_k_hdr",
              "text": "Legal Identity Verification",
              "style": "titleMedium",
              "color": "#FFFFFF"
            },
            {
              "type": "text",
              "id": "t_k_sub",
              "text": "Toggle business account to see visible_if in action.",
              "style": "bodySmall",
              "color": "#94A3B8"
            }
          ]
        }
      },
      {
        "type": "switch",
        "id": "sw_biz",
        "state_key": "is_business",
        "label": "Are you registering a Corporate Account?",
        "initial_checked": false
      },
      {
        "type": "text_field",
        "id": "tf_name",
        "state_key": "legal_name",
        "label": "Full Legal Name",
        "placeholder": "e.g. Julian Velandia",
        "validation_rules": [
          {
            "type": "REQUIRED",
            "error_message": "Legal name is required"
          },
          {
            "type": "MIN_LENGTH",
            "value": "3",
            "error_message": "Minimum 3 characters"
          }
        ]
      },
      {
        "type": "text_field",
        "id": "tf_tax",
        "state_key": "tax_id",
        "label": "Corporate Tax ID / NIT",
        "placeholder": "900.876.543-1",
        "visible_if": "is_business == 'true'",
        "validation_rules": [
          {
            "type": "REQUIRED",
            "error_message": "Tax ID is required"
          },
          {
            "type": "CUSTOM",
            "value": "COLOMBIAN_NIT",
            "error_message": "Invalid tax ID (9 digits)"
          }
        ]
      },
      {
        "type": "select",
        "id": "doc_type",
        "state_key": "doc_type",
        "label": "Document type",
        "placeholder": "Select one",
        "options": [
          {
            "value": "cc",
            "label": "Cédula de ciudadanía"
          },
          {
            "value": "ce",
            "label": "Cédula de extranjería"
          },
          {
            "value": "passport",
            "label": "Passport"
          }
        ],
        "validation_rules": [
          {
            "type": "REQUIRED",
            "error_message": "Pick a document type"
          }
        ]
      },
      {
        "type": "date_picker",
        "id": "dob",
        "state_key": "birth_date",
        "label": "Date of birth",
        "placeholder": "YYYY-MM-DD",
        "min_date": "1900-01-01",
        "max_date": "2007-12-31",
        "validation_rules": [
          {
            "type": "REQUIRED",
            "error_message": "Date of birth is required"
          }
        ],
        "confirm_text": "Aceptar",
        "dismiss_text": "Cancelar"
      },
      {
        "type": "radio_group",
        "id": "funds",
        "state_key": "funds_origin",
        "label": "Origin of funds",
        "options": [
          {
            "value": "salary",
            "label": "Salary"
          },
          {
            "value": "business",
            "label": "Business income"
          },
          {
            "value": "investments",
            "label": "Investments"
          }
        ],
        "initial_value": "salary"
      },
      {
        "type": "checkbox",
        "id": "terms",
        "state_key": "accepted_terms",
        "label": "I accept the terms and the privacy policy",
        "validation_rules": [
          {
            "type": "REQUIRED",
            "error_message": "You must accept to continue"
          }
        ]
      },
      {
        "type": "button",
        "id": "btn_sub_kyc",
        "title": "Submit KYC Verification",
        "variant": "FILLED",
        "is_full_width": true,
        "actions": [
          {
            "type": "set_state",
            "key": "submitted_at",
            "value": "now",
            "tracking": {
              "event": "kyc_submit_tapped",
              "vertical": "fintech"
            }
          },
          {
            "type": "submit_form",
            "endpoint": "https://httpbin.org/post",
            "method": "POST",
            "payload": {
              "legal_name": "{{state.legal_name}}",
              "tax_id": "{{state.tax_id}}",
              "is_business": "{{state.is_business}}",
              "channel": "mobile-demo",
              "doc_type": "{{state.doc_type}}",
              "birth_date": "{{state.birth_date}}",
              "funds_origin": "{{state.funds_origin}}",
              "accepted_terms": "{{state.accepted_terms}}"
            }
          },
          {
            "type": "navigate",
            "screen_id": "fintech",
            "tracking": {
              "event": "kyc_success_viewed"
            }
          }
        ]
      }
    ]
  }
}
