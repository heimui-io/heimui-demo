{
  "$schema": "https://heimui.io/schema/v1/screen.json",
  "id": "food_feed",
  "version": "1.0.0",
  "title": "Kitchens & Deals",
  "apply_safe_insets": true,
  "root": {
    "type": "lazy_column",
    "id": "food_feed_col",
    "spacing": 16,
    "padding": 16,
    "items": [
      {
        "type": "card",
        "id": "food_hero",
        "background_color": "#161D2F",
        "border_color": "#10B981",
        "corner_radius": 16,
        "padding": 18,
        "child": {
          "type": "container",
          "id": "f_h_box",
          "direction": "VERTICAL",
          "spacing": 6,
          "children": [
            {
              "type": "badge",
              "id": "b_f_promo",
              "text": "🍕 2X1 TUESDAYS",
              "background_color": "#10B981",
              "text_color": "#0B0F19"
            },
            {
              "type": "text",
              "id": "t_f_deal",
              "text": "Gourmet Pizza & Burgers",
              "style": "headlineSmall",
              "color": "#FFFFFF"
            },
            {
              "type": "text",
              "id": "t_f_meta",
              "text": "Free delivery on orders over $25.",
              "style": "bodySmall",
              "color": "#94A3B8"
            }
          ]
        }
      },
      {
        "type": "text",
        "id": "t_top_kitch",
        "text": "Popular Spots Nearby",
        "style": "titleMedium",
        "color": "#10B981"
      },
      {
        "type": "card",
        "id": "rest_1",
        "background_color": "#1E293B",
        "corner_radius": 12,
        "padding": 14,
        "child": {
          "type": "container",
          "id": "r_row_1",
          "direction": "HORIZONTAL",
          "spacing": 12,
          "alignment": "CENTER",
          "children": [
            {
              "type": "icon",
              "id": "ic_r1",
              "name": "local_pizza",
              "tint": "#10B981",
              "size": 36
            },
            {
              "type": "container",
              "id": "r_txt_1",
              "direction": "VERTICAL",
              "spacing": 2,
              "children": [
                {
                  "type": "text",
                  "id": "n_r1",
                  "text": "Napoli Artisan Pizza",
                  "style": "bodyLarge",
                  "color": "#FFFFFF"
                },
                {
                  "type": "text",
                  "id": "m_r1",
                  "text": "⭐ 4.9 · Italian · 20-30 min",
                  "style": "bodySmall",
                  "color": "#00E5FF"
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
