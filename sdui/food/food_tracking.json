{
  "${'$'}schema": "https://heimui.io/schema/v1/screen.json",
  "id": "food_tracking",
  "version": "1.0.0",
  "title": "Live Order Status",
  "apply_safe_insets": true,
  "root": {
    "type": "lazy_column",
    "id": "track_col",
    "spacing": 16,
    "padding": 16,
    "items": [
      {
        "type": "card",
        "id": "card_active_order",
        "background_color": "#161D2F",
        "border_color": "#00E5FF",
        "corner_radius": 16,
        "padding": 20,
        "child": {
          "type": "container",
          "id": "tr_box",
          "direction": "VERTICAL",
          "spacing": 10,
          "children": [
            { "type": "badge", "id": "b_tr_status", "text": "🛵 ON THE WAY · ETA: 12 MINS", "background_color": "#00E5FF", "text_color": "#0B0F19" },
            { "type": "text", "id": "t_tr_rest", "text": "Napoli Artisan Pizza #4829", "style": "TITLE_LARGE", "color": "#FFFFFF" },
            { "type": "text", "id": "t_driver", "text": "Driver: Carlos R. (Yamaha MT-03)", "style": "BODY_MEDIUM", "color": "#94A3B8" },
            {
              "type": "button",
              "id": "btn_call_driver",
              "title": "Contact Driver",
              "variant": "OUTLINED",
              "is_full_width": true,
              "actions": [
                { "type": "show_snackbar", "message": "📞 Connecting with Carlos..." }
              ]
            }
          ]
        }
      }
    ]
  }
}
