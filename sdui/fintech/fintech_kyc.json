{
  "${'$'}schema": "https://heimui.io/schema/v1/screen.json",
  "id": "fintech_kyc",
  "version": "1.0.0",
  "title": "KYC Verification",
  "apply_safe_insets": true,
  "root": {
    "type": "lazy_column",
    "id": "kyc_col",
    "spacing": 16,
    "padding": 16,
    "items": [
      {
        "type": "card",
        "id": "kyc_banner",
        "background_color": "#161D2F",
        "corner_radius": 12,
        "padding": 16,
        "child": {
          "type": "container",
          "id": "kyc_t_box",
          "direction": "VERTICAL",
          "spacing": 4,
          "children": [
            { "type": "badge", "id": "b_reg", "text": "REGULATORY ONBOARDING", "background_color": "#4F46E5", "text_color": "#FFFFFF" },
            { "type": "text", "id": "t_k_hdr", "text": "Legal Identity Verification", "style": "TITLE_MEDIUM", "color": "#FFFFFF" },
            { "type": "text", "id": "t_k_sub", "text": "Toggle business account to see visible_if in action.", "style": "BODY_SMALL", "color": "#94A3B8" }
          ]
        }
      },
      {
        "type": "switch",
        "id": "sw_biz",
        "state_key": "is_business",
        "label": "Are you registering a Corporate Account?",
        "initial_checked": false
      },
      {
        "type": "text_field",
        "id": "tf_name",
        "state_key": "legal_name",
        "label": "Full Legal Name",
        "placeholder": "e.g. Julian Velandia",
        "validation_rules": [
          { "type": "REQUIRED", "error_message": "Legal name is required" }
        ]
      },
      {
        "type": "text_field",
        "id": "tf_tax",
        "state_key": "tax_id",
        "label": "Corporate Tax ID / NIT",
        "placeholder": "900.876.543-1",
        "visible_if": "is_business == 'true'",
        "validation_rules": [
          { "type": "REQUIRED", "error_message": "Tax ID is mandatory for corporate accounts" }
        ]
      },
      {
        "type": "button",
        "id": "btn_sub_kyc",
        "title": "Submit KYC Verification",
        "variant": "FILLED",
        "is_full_width": true,
        "actions": [
          {
            "type": "show_dialog",
            "title": "KYC Verified ✅",
            "message": "Your corporate compliance form was verified and approved fail-closed.",
            "confirm_text": "Done"
          }
        ]
      }
    ]
  }
}
